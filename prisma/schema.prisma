generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

model Bet {
    id          Int       @id @default(autoincrement())
    site_id     Int
    game_id     Int
    region_id   Int
    round_id    Int
    customer_id Int
    user_id     Int
    ticket_id   Int
    index       Int       @map("index") // Agrupamento de números no bilhete
    status      Int // 1 - Aberto | 2 - Ganhou | 3 - Perdeu | 4 - Cancelado
    number      Int // Número escolhido
    created_at  DateTime  @db.Timestamp(0)
    updated_at  DateTime  @updatedAt @db.Timestamp(0)
    deleted_at  DateTime? @db.Timestamp(0)

    ticket Ticket @relation(fields: [ticket_id], references: [id])

    @@index([ticket_id])
    @@index([deleted_at])
    @@index([number])
    @@index([status])
    @@map("bets")
}

model Customer {
    id         Int       @id @default(autoincrement())
    site_id    Int
    user_id    Int // Usuário que indicou
    name       String?   @db.VarChar(100)
    email      String?   @db.VarChar(100)
    phone      String    @unique @db.VarChar(20)
    document   String?   @db.VarChar(20)
    last_login DateTime? @db.Timestamp(0)
    created_at DateTime  @default(now()) @db.Timestamp(0)
    updated_at DateTime  @updatedAt @db.Timestamp(0)
    deleted_at DateTime? @db.Timestamp(0)

    user    User     @relation(fields: [user_id], references: [id])
    tickets Ticket[]

    @@index([site_id])
    @@index([user_id])
    @@index([created_at])
    @@index([deleted_at])
    @@map("customers")
}

model Game {
    id         Int       @id @default(autoincrement())
    status     Int       @default(1)
    name       String    @db.VarChar(50)
    img        String    @db.VarChar(300)
    created_at DateTime  @default(now()) @db.Timestamp(0)
    updated_at DateTime  @updatedAt @db.Timestamp(0)
    deleted_at DateTime? @db.Timestamp(0)

    rounds  Round[]
    tickets Ticket[]

    @@index([status])
    @@index([deleted_at])
    @@map("games")
}

model Ip {
    id Int @id @default(autoincrement())

    ip String @db.VarChar(50)

    country_code String @db.VarChar(3)

    is_vpn       Boolean @db.TinyInt
    is_tor       Boolean @db.TinyInt
    is_anonymous Boolean @db.TinyInt

    is_attacker Boolean @db.TinyInt
    is_abuser   Boolean @db.TinyInt
    score       Int

    whitelisted Boolean @db.TinyInt

    data String @db.MediumText

    created_at DateTime  @default(now()) @db.Timestamp(0)
    updated_at DateTime  @updatedAt @db.Timestamp(0)
    deleted_at DateTime? @db.Timestamp(0)

    @@index([ip])
    @@index([created_at])
    @@index([deleted_at])
    @@map("ips")
}

model Region {
    id         Int       @id @default(autoincrement())
    name       String    @db.VarChar(30)
    created_at DateTime  @default(now()) @db.Timestamp(0)
    updated_at DateTime  @updatedAt @db.Timestamp(0)
    deleted_at DateTime? @db.Timestamp(0)

    rounds  Round[]
    tickets Ticket[]
    users   User[]

    @@index([created_at])
    @@index([deleted_at])
    @@map("regions")
}

model Round {
    id                 Int       @id @default(autoincrement())
    site_id            Int
    game_id            Int
    region_id          Int
    status             Int // 1 - Aberto | 2 - Finalizado | 4 - Cancelado
    name               String    @db.VarChar(100)
    end_date           DateTime  @db.Timestamp(0)
    payout_total       Int // Em centavos
    payout_accumulated Int // Valor de rodadas anteriores
    payout_first       Int // Em centavos
    payout_second      Int // Em centavos
    payout_third       Int // Em centavos
    bets_qty           Int
    bets_amount        Int // Em centavos
    created_at         DateTime  @default(now()) @db.Timestamp(0)
    updated_at         DateTime  @updatedAt @db.Timestamp(0)
    deleted_at         DateTime? @db.Timestamp(0)

    game    Game     @relation(fields: [game_id], references: [id])
    region  Region   @relation(fields: [region_id], references: [id])
    tickets Ticket[]

    @@index([site_id])
    @@index([game_id])
    @@index([region_id])
    @@index([end_date])
    @@index([deleted_at])
    @@map("rounds")
}

model Site {
    id Int @id @default(autoincrement())

    user_id Int
    token   String @db.VarChar(50)
    url     String @db.VarChar(200)

    status Int
    name   String @db.VarChar(50)

    created_at DateTime  @default(now()) @db.Timestamp(0)
    updated_at DateTime  @updatedAt @db.Timestamp(0)
    deleted_at DateTime? @db.Timestamp(0)

    @@index([user_id])
    @@index([token])
    @@index([created_at])
    @@index([deleted_at])
    @@map("sites")
}

model Ticket {
    id               Int       @id @default(autoincrement())
    site_id          Int
    game_id          Int
    region_id        Int
    round_id         Int
    customer_id      Int
    user_id          Int
    status           Int // 1 - Aberto | 2 - Ganhou | 3 - Perdeu | 4 - Cancelado
    amount           Int // Em centavos
    payout           Int // Em centavos
    currency         String    @default("brl") @db.VarChar(5)
    total_commission Int // Em centavos
    created_at       DateTime  @default(now()) @db.Timestamp(0)
    updated_at       DateTime  @updatedAt @db.Timestamp(0)
    deleted_at       DateTime? @db.Timestamp(0)

    game         Game          @relation(fields: [game_id], references: [id])
    region       Region        @relation(fields: [region_id], references: [id])
    round        Round         @relation(fields: [round_id], references: [id])
    customer     Customer      @relation(fields: [customer_id], references: [id])
    user         User          @relation(fields: [user_id], references: [id])
    bets         Bet[]
    transactions Transaction[]

    @@index([site_id])
    @@index([user_id])
    @@index([customer_id])
    @@index([created_at])
    @@index([deleted_at])
    @@index([region_id])
    @@index([round_id])
    @@map("tickets")
}

model Transaction {
    id          Int       @id @default(autoincrement())
    site_id     Int
    user_id     Int
    ticket_id   Int
    status      Int
    type        Int       @db.TinyInt
    title       String    @db.VarChar(50)
    description String    @db.VarChar(50)
    amount      Int // Em centavos
    currency    String    @default("brl") @db.VarChar(5)
    created_at  DateTime  @default(now()) @db.Timestamp(0)
    updated_at  DateTime  @updatedAt @db.Timestamp(0)
    deleted_at  DateTime? @db.Timestamp(0)

    user   User   @relation(fields: [user_id], references: [id])
    ticket Ticket @relation(fields: [ticket_id], references: [id])

    @@index([site_id])
    @@index([user_id])
    @@index([created_at])
    @@index([deleted_at])
    @@index([ticket_id])
    @@map("transactions")
}

model User {
    id                    Int       @id @default(autoincrement())
    site_id               Int
    validated             Boolean   @db.TinyInt // Usuário validou e-mail e telefone?
    status                Int       @default(1)
    type                  Int       @default(10) // 1 - Superadmin | 2 - Admin | 5 - Gestor | 10 - Vendedor
    region_id             Int       @default(0)
    manager_id            Int       @default(0) // ID do gestor
    login                 String    @db.VarChar(30)
    name                  String    @db.VarChar(200)
    email                 String    @db.VarChar(200)
    password              String    @db.VarChar(255)
    phone                 String?   @db.VarChar(20)
    document              String?   @db.VarChar(20)
    img                   String    @default("https://staketech.s3.us-east-1.amazonaws.com/cdn/avatars/0.jpg") @db.VarChar(500)
    bet_credit            Int       @default(0) // Em centavos
    balance               Int       @default(0) // Em centavos
    currency              String    @default("brl") @db.VarChar(5)
    current_refresh_token String?   @db.VarChar(500)
    refresh_token_id      String?   @db.VarChar(64)
    user_token            String?   @db.VarChar(64)
    last_login            DateTime? @db.Timestamp(0)
    permissions           Json?
    created_at            DateTime  @default(now()) @db.Timestamp(0)
    updated_at            DateTime  @updatedAt @db.Timestamp(0)
    deleted_at            DateTime? @db.Timestamp(0)

    region       Region        @relation(fields: [region_id], references: [id])
    customers    Customer[]
    tickets      Ticket[]
    transactions Transaction[]

    @@unique([site_id, email, deleted_at], name: "users_brand_id_email_deleted_at_key")
    @@index([type])
    @@index([login])
    @@index([name])
    @@index([email])
    @@index([document])
    @@index([site_id])
    @@index([manager_id])
    @@index([created_at])
    @@index([deleted_at])
    @@index([user_token])
    @@index([region_id])
    @@map("users")
}

model PasswordReset {
    id         Int      @id @default(autoincrement())
    email      String
    token      String
    expires_at DateTime
    used       Boolean  @default(false)
    created_at DateTime @default(now())

    @@map("password_resets")
}
